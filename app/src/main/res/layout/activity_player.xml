<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <com.hu.medialoop.player.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="matrix" />

    <VideoView
        android:id="@+id/video_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:visibility="gone" />

    <com.hu.medialoop.player.CollageView
        android:id="@+id/collage_view"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="matrix" android:visibility="gone" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="top" android:padding="8dp"
        android:background="#88000000" android:textColor="#FFFFFFFF"
        android:textSize="14sp" android:maxLines="2" />

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="horizontal"
        android:gravity="center" android:padding="8dp" android:background="#88000000">

        <Button android:id="@+id/btn_collage" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="拼接模式" android:textSize="12sp" />
        <Button android:id="@+id/btn_next" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="下一张" android:textSize="12sp" />
        <Button android:id="@+id/btn_exit" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="退出" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
